# Groq API key (required for caption generation)
GROQ_API_KEY=your_groq_api_key_here

# Groq vision model (optional)
GROQ_MODEL=qwen/qwen3.8-27b

# Frontend URL for CORS (optional, defaults to http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# Clerk server authentication. Keep the secret key on the server only.
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# Server Port (optional, defaults to 3000)
PORT=3000

# SQLite file location (optional, defaults to server/captions.db)
# DB_PATH=/var/data/captions.db
